# ML models are large binaries and change frequently during training -- share via
# Drive/Colab, not git. Drop the current one at app/src/main/assets/best.tflite locally.
*.tflite

# Firebase config carries a project API key -- share it directly with the team
# instead of committing it (see SETUP.md for how to get one).
app/google-services.json

# Exported APKs for sharing with the team/testers -- large binaries, share via Drive not git.
/exports/

# Training notebooks belong in Colab/Drive, not this repo -- also keeps a pasted API key
# (Roboflow, etc.) in a scratch notebook from ever landing in git by accident.
*.ipynb
training/*_colab_snippet.py

